{
  "name": "cosmic-expansion-ts",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig tsconfig.json",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "wasm:copy": "node scripts/copy-wasm.mjs",
    "wasm:build": "pnpm --dir ../cosmic-expansion-haskell --silent exec hpack && pnpm --dir ../cosmic-expansion-haskell --silent exec cabal build --project-file=cabal.project.wasm cosmic-expansion-wasm && pnpm run wasm:copy"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "^5.46.1",
    "svelte-check": "^4.3.5",
    "tslib": "^2.8.1",
    "typescript": "^5.5.4",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2"
  }
}
